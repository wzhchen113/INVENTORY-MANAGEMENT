          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Sauce</td>
            <td class="num">12.5</td>
            <td class="num">0</td>
            <td class="num">10</td>
            <td class="num"><span class="strong">0 gal</span></td>
            <td>gal</td>
          </tr></tbody>
      </table>
      <h2 class="enough">Sysco &middot; Source: STOCK FALLBACK &middot; Next delivery: 2026-10-24 (in 3 days)</h2>
      <table class="enough">
        <thead>
          <tr>
